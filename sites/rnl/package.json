{
  "name": "rnl-public-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare:shared": "node scripts/prepare-shared.mjs",
    "dev": "npm run prepare:shared && next dev --webpack -p 3108",
    "build": "npm run prepare:shared && next build --webpack",
    "start": "next start -p 3108",
    "lint": "eslint app components lib scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/credential-boundary-regression.mjs && node --conditions=react-server --experimental-strip-types scripts/regression.mjs && node --conditions=react-server --experimental-strip-types scripts/submission-runtime-regression.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "test:brand": "node scripts/brand-regression.mjs",
    "test:consent": "node --experimental-strip-types scripts/sms-consent-regression.mjs && node scripts/request-form-regression.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "typescript": "^5"
  }
}
